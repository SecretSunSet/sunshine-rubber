---
import { navLinks, isActive } from "../data/nav";

const pathname = Astro.url.pathname;
---

<!-- Desktop header (>=768px) -->
<header class="hdr desktop-only">
  <div class="hdr-inner container">
    <a href="/" class="brand" aria-label="Sunshine Rubber Tech Resources — home">
      <img src="/images/sunshine-logo.svg" alt="" width="64" height="64" class="brand-logo" />
      <span class="brand-text">
        <span class="brand-name">SUNSHINE RUBBER</span>
        <span class="brand-sub">TECH RESOURCES, CO.</span>
      </span>
    </a>
    <nav class="nav" aria-label="Primary">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={["nav-link", { active: isActive(link.href, pathname) }]}
            aria-current={isActive(link.href, pathname) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a href="/contact" class="quote-btn">Request a Quote</a>
    </nav>
  </div>
</header>

<!-- Mobile header (<768px) — centered logo, nav lives in the bottom tab bar -->
<header class="hdr-m mobile-only">
  <div class="hdr-m-inner">
    <a href="/" class="brand-m" aria-label="Sunshine Rubber Tech Resources — home">
      <img src="/images/sunshine-logo.svg" alt="" width="42" height="42" class="brand-logo-m" />
      <span class="brand-text">
        <span class="brand-name-m">SUNSHINE RUBBER</span>
        <span class="brand-sub-m">TECH RESOURCES, CO.</span>
      </span>
    </a>
  </div>
</header>

<style>
  /* ---- Desktop ---- */
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(250, 248, 243, 0.88);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .hdr-inner {
    height: 86px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
  }
  .brand-logo {
    width: 64px;
    height: 64px;
    object-fit: contain;
    display: block;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1;
  }
  .brand-name {
    font: 800 22px/1 var(--font-display);
    letter-spacing: 0.02em;
    color: var(--ink);
  }
  .brand-sub {
    font: 600 11px/1.4 var(--font-body);
    letter-spacing: 0.26em;
    color: var(--brand-sub);
    margin-top: 4px;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 30px;
  }
  .nav-link {
    font: 600 15px/1 var(--font-body);
    color: var(--ink);
    text-decoration: none;
    padding: 8px 0;
  }
  .nav-link.active {
    font-weight: 700;
    color: var(--accent);
  }
  .nav-link:hover {
    color: var(--accent);
  }
  .quote-btn {
    background: var(--accent);
    color: #fff;
    font: 600 14px/1 var(--font-body);
    padding: 12px 20px;
    border-radius: var(--r-pill);
    text-decoration: none;
    transition: filter 0.15s ease;
  }
  .quote-btn:hover {
    filter: brightness(0.93);
  }

  /* ---- Mobile ---- */
  .hdr-m {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(250, 248, 243, 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .hdr-m-inner {
    padding: 0 var(--gutter-m);
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .brand-m {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .brand-logo-m {
    width: 42px;
    height: 42px;
    object-fit: contain;
    display: block;
  }
  .brand-name-m {
    font: 800 15px/1 var(--font-display);
    letter-spacing: 0.01em;
    color: var(--ink);
  }
  .brand-sub-m {
    font: 600 8px/1.4 var(--font-body);
    letter-spacing: 0.22em;
    color: var(--brand-sub);
    margin-top: 3px;
  }
</style>
